    public static void ContinueOrNot()
    {
        Scanner key = new Scanner(System.in);
        System.out.println("\n***  THANK YOU  ***");
        System.out.println("Would u like to continue then      click 'y' ");
        System.out.println("or if u like to exit or terminate  click 'n'");
        char choose = key.next().charAt(0);
        char choice = Character.toLowerCase(choose);
        if (choice == 'y')
        {
            gender();
        }
        else if (choice == 'n')
        {
            System.exit(0);
        }
        else
        {
            System.out.println("invalid Choice");
            System.out.println("Pls enter correct choice");
            ContinueOrNot();
        }
    }
