    public static void printDetail(int distance, int fare)
    {
        Scanner key = new Scanner(System.in);
        LocalDateTime hi = LocalDateTime.now();
        System.out.println("|__________**** K.S.R.T.C ****__________");
        System.out.println("|Depo :"+depo+"                 TIME:"+hi.toLocalTime().withNano(0));
        System.out.println("|"+Bus_no+"               Date:"+hi.toLocalDate());
        System.out.println("|          START : " + getFullStartName(start));
        System.out.println("|                  to ");
        System.out.println("|          END : " + getFullEndName(end));

        System.out.println("| Distance: " + distance + " km");
        System.out.println("| Fare: ₹" + fare);
        totalEarned += fare;
        System.out.println("|________________________________________");


        System.out.println("If u have entered to DEPO then :");
        System.out.println("enter 'y' for yes \nenter 'n' for no");
        char choose = key.next().charAt(0);
        char choice = Character.toLowerCase(choose);
        if( choice == 'y')
        {
            System.out.println("\t::::::::::::::::::::::::::::");
            System.out.println("\t| Date : "+hi.toLocalDate() +"        |");
            System.out.println("\t| Time  : "+hi.toLocalTime().withNano(0)+"         |");
            System.out.println("\t| Depo no : "+depo+"             |");
            System.out.println("\t| Bus No : "+Bus_no+"       |");
            System.out.println("\t| Driver id no : "+driver_id+"      |");
            System.out.println("\t| Total Earned so far: ₹ " + totalEarned+"|");
            System.out.println("\t::::::::::::::::::::::::::::");
            ContinueOrNot();
        }
        else if(choice == 'n')
        {
            ContinueOrNot();
        }
    }


    public static String getFullStartName(String start)
    {
        switch (start)
        {
            case "b":
                return "Bidadi";
            case "r":
                return "Ramanagara";
            case "c":
                return "Channapatna";
            case "mu":
                return "Madhur";
            case "mn":
                return "Mandya";
            case "s":
                return "Srirangapatna";
            case "my":
                return "Mysore";
            default:
                return "Unknown";
        }
    }

