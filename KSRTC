
import java.time.LocalDateTime;
import java.util.Scanner;

public class KSRTC
{
    static String start, end,Bus_no , driver_id;
    static int depo;
    static int totalEarned = 0;
    public static void main(String[] args)
    {
        // printMenu();
    }

    static
    {
        Scanner key = new Scanner(System.in);
        System.out.println("Enter bus number : ");
        Bus_no = key.next();
        System.out.println("Enter depo number: ");
        depo = key.nextInt();
        System.out.println("Enter driver id no: ");
        driver_id = key.next();
        gender();
    }
    public static void gender()
    {
        Scanner key = new Scanner(System.in);
        System.out.println("Enter gender female (F) or male (M)");
        char gen = key.next().charAt(0);
        char gender = Character.toLowerCase(gen);
        if(gender == 'f')
        {
            printMenu();
            printDetail(0,0);
        }
        else if(gender == 'm')
        {
            printMenu();
            place();
        }
        else
        {
            System.out.println("Invalid choice try again");
            gender();
        }
    }

    public static void printMenu()
    {
        System.out.println("\tFor Bidadi press B");
        System.out.println("\tFor Ramanagara press R");
        System.out.println("\tFor Channapatna press C");
        System.out.println("\tFor Madhur press MU");
        System.out.println("\tFor Mandya press MN");
        System.out.println("\tFor Srirangapatna press S");
        System.out.println("\tFor Mysore press MY");

        Scanner key = new Scanner(System.in);
        System.out.println("Enter your starting place");
        start = key.next().toLowerCase();

        System.out.println("Enter your ending place");
        end = key.next().toLowerCase();
        //place();

    }

    public static void place()
    {
        switch (start)
        {
            case "b":
                bidadiDestination(end);
                break;

            case "r":
                ramanagaraDestination(end);
                break;

            case "c":
                channapatnaDestination(end);
                break;

            case "mu":
                madhurDestination(end);
                break;

            case "mn":
                mandyaDestination(end);
                break;

            case "s":
                srirangapatnaDestination(end);
                break;

            case "my":
                System.out.println("It's your last destination");
                break;

            default:
                System.out.println("Invalid starting place");
        }

        ContinueOrNot();
    }

